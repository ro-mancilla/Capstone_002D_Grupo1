VITE_API_BASE_URL=http://localhost:8080

# One-tap sign-in for the seeded `reference` tenant, shown above the login form. On by default --
# this line only exists to switch it off, which is the one thing to do before serving the
# dashboard to anyone outside the project, since the row publishes seeded passwords by design.
# VITE_DEV_QUICK_LOGIN=false
