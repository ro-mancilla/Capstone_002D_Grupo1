<resources>
    <!-- The same binary is the till and the baker's phone (01 §1), so this screen must not name
         one of them. "Caja"/"este computador" wording lived here and read as nonsense on a phone. -->
    <string name="auth_app_name">Ecopan</string>

    <string name="auth_enroll_kicker">REGISTRO DE DISPOSITIVO</string>
    <string name="auth_enroll_title">Registrar este dispositivo</string>
    <string name="auth_enroll_subtitle">Conecta este dispositivo a tu panadería una sola vez. Tras el registro queda enlazado y funciona completamente sin conexión.</string>
    <string name="auth_enroll_tenant_label">Panadería (identificador)</string>
    <string name="auth_enroll_username_label">Usuario</string>
    <string name="auth_enroll_password_label">Contraseña</string>
    <string name="auth_enroll_device_name_label">Nombre del dispositivo</string>
    <string name="auth_enroll_device_name_hint">Identifica este dispositivo en la administración.</string>
    <string name="auth_enroll_submit">Registrar dispositivo</string>
