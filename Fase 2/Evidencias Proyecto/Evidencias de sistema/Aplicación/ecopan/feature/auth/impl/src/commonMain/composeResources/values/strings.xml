    <string name="auth_enroll_error_invalid_credentials">No pudimos iniciar sesión. Revisa el identificador de la panadería, el usuario y la contraseña.</string>
    <string name="auth_enroll_too_many_attempts">Demasiados intentos seguidos. Espera un minuto e intenta de nuevo.</string>
