         the screen is asking about rather than describing the PIN step below it. -->
    <string name="auth_lock_staff_section">¿Quién está en la caja?</string>
    <string name="auth_lock_choose_name_title">Elige tu nombre</string>
    <string name="auth_lock_choose_name_sub">Luego ingresa tu PIN de 4 dígitos</string>
