         only cue is a tint, which a screen reader never announces. -->
    <string name="auth_bootstrap_step_done">Completado</string>
    <string name="auth_bootstrap_step_active">En curso</string>
    <string name="auth_bootstrap_step_pending">Pendiente</string>
    <string name="auth_pin_backspace_cd">Borrar último dígito</string>

