# Backend / frontend
.env
backend/**/.env
# ...but the committed template must stay tracked -- it is what a fresh clone copies from.
!backend/app/.env.example
frontend/dist/
frontend/node_modules/

# Unrelated local scratch content, not part of this project
/spec/
# Generated deployment secrets (infra/deploy.sh). Never commit.
infra/.env.local

# Kaggle API credentials. Never commit — kaggle.json is a live secret (username + API key)
# and grants full access to the account. The canonical home is ~/.kaggle/kaggle.json; this entry
# exists because a copy landing in the repo root is an easy and costly mistake.
.kaggle/
kaggle.json

# Impeccable ships a ~12 MB per-platform binary under scripts/bin/. The launcher downloads it on
# first run, so it is a build artifact of one developer's machine, not source -- and git would keep
# every version of it forever. The skill's references and launcher scripts are tracked.
.claude/skills/impeccable/scripts/bin/

# Academic deliverables (Scrum evidence for the course) and the tooling that generates them.
# They describe the course process, not the product, and are rebuilt from docs/tools.
/docs/scrum/
/docs/tools/
/docs/templates/
/docs/ppt/
/docs/Informe_Definicion_Proyecto_APT*.docx
/scrum-*.zip

# Generated by scripts/evidence-pack.sh
/docs/defense/evidence/
