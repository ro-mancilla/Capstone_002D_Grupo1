<?xml version="1.0" encoding="utf-8"?>
<!--
  nonMinifiedRelease and benchmarkRelease ONLY (see `androidComponents` in android/app/build.gradle.kts).
  The Baseline Profile journeys enrol against a local backend over `adb reverse`, i.e. http://localhost:8080,
  and these two build types are release-shaped, so they inherit `src/main`'s HTTPS-only policy and could
  not reach it. This lets cleartext through to `localhost` and nothing else. Never packaged into release.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
