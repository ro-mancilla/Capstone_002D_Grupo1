# Copy to backend/app/.env before `docker compose up` -- the real .env is gitignored, and
# docker-compose fails outright when an `env_file:` is missing.
#
# These are LOCAL DEVELOPMENT values. JWT_SECRET in particular is a well-known placeholder and
# must be replaced with a real secret anywhere the backend is reachable by anyone else.

PORT=8080

# Hostnames are compose service names, not localhost -- containers resolve each other by service.
DB_HOST=db
DB_PORT=5432
DB_NAME=ecopan
DB_USERNAME=postgres
DB_PASSWORD=postgres

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=jobs
RABBITMQ_QUEUE=jobs.queue
RABBITMQ_ROUTING_KEY=jobs.key
RABBITMQ_PREFETCH=4
RABBITMQ_DEAD_LETTER_EXCHANGE=jobs.dlx
RABBITMQ_DEAD_LETTER_QUEUE=jobs.dlq
RABBITMQ_JOB_EVENTS_EXCHANGE=job.events
RABBITMQ_JOB_EVENTS_QUEUE=job.events
RABBITMQ_SSE_EXCHANGE=notifications.sse
RABBITMQ_SSE_DEBOUNCE_MS=250

JWT_SECRET=dev-secret
# The backend refuses dev-secret unless JWT_ALLOW_DEV_SECRET=true; docker-compose.yml sets that for you.
JWT_ISSUER=ecopan
JWT_AUDIENCE=ecopan-clients
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
DEVICE_SESSION_TTL_DAYS=180
REPORTING_TZ=America/Santiago

# Seed profiles loaded at boot, comma-separated. docker-compose.yml already sets this for the
# `web` service; listed here so the variable is discoverable when running the backend directly.
SEED_PROFILE=reference

# Browser origins allowed to call this API, comma-separated whole origins (no wildcard). Only the
# web dashboard needs this -- the desktop till and baker app are not browsers and ignore CORS.
# Defaults cover Vite's dev server (5173) and its `preview` server (4173); override for a deployed
# dashboard. An origin includes the port, so 5173 does not admit 5174.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Product photos (Azure Blob Storage, Azurite locally). docker-compose.yml sets both of these for
# the `web` service; listed here for a backend run directly against the published Azurite port.
# In Azure the deployment sets STORAGE_ACCOUNT_URL instead and the app uses its managed identity.
# STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;
# STORAGE_PUBLIC_BLOB_BASE_URL=http://localhost:10000/devstoreaccount1
# STORAGE_CONTAINER=product-images
